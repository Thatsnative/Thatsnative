<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start|center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/number"
        style="@style/TextStyleBody1.Red"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/onboarding_descriptor_background_corner_8"
        android:paddingHorizontal="@dimen/margin_11"
        android:paddingVertical="@dimen/margin_5"
        android:text="1" />

    <TextView
        android:id="@+id/description"
        style="@style/TextStyleBody1"
        android:maxLines="2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_16"
        android:text="@string/turn_on_adblock_avlyx" />

</LinearLayout>