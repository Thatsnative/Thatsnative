<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_8"
    android:background="@drawable/filter_item_background_corner_16"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="@dimen/margin_16">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/securityIcon"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/ic_malware_40" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/securityDescriptionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_8"
        android:layout_weight="2"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/securityTitle"
            style="@style/TextStyleBody1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/security" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/securityDescription"
            style="@style/TextStyleBody3.Gray1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4"
            android:text="@string/malware_scam_site_protection" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/securitySwitchButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:thumb="@drawable/ic_switch_thumb_selector"
        app:track="@drawable/ic_shwitch_track_selector" />

</androidx.appcompat.widget.LinearLayoutCompat>